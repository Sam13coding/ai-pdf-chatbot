NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIMENSIONS=2048
DATABASE_URL=postgresql://pdfchat:pdfchat@localhost:5432/pdfchat
DATA_DIR=data
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
MAX_PDF_MB=20
OCR_ENABLED=true
# Directory containing eng.traineddata; absolute or relative to backend/.
TESSDATA_PREFIX=../.tools/Tesseract-OCR/tessdata
